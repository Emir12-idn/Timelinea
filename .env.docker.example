# Copy to `.env` in the repo root (same folder as docker-compose.yml) and fill in.

# Your domain, pointed at this PC's public IP (A record). Caddy auto-issues
# HTTPS for it. Use your PC's LAN IP or "localhost" while testing without a domain.
DOMAIN=portal.emeralddutasejahtera.my.id

# Postgres
DB_USER=emerald
DB_PASSWORD=change-this-password
DB_NAME=emerald

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Allowed frontend origin(s) for CORS, comma-separated. Defaults to https://$DOMAIN.
# CORS_ORIGIN=https://portal.emeralddutasejahtera.my.id

# First-run admin login (used by `prisma db seed`)
SEED_ADMIN_EMAIL=admin@emeralddutasejahtera.co.id
SEED_ADMIN_PASSWORD=change-this-password

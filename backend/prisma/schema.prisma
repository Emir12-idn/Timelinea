// Emerald Duta Sejahtera — Business Portal
// Data model following docs/DATA_DESIGN.md (§3 Entitas & field, §4 Jurnal otomatis, §5 COA).
// Conventions: every table has id/created_at/updated_at (+created_by where user-entered),
// money stored as BigInt (integer rupiah, no decimals), soft delete via deleted_at.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  hrd_keuangan
  pic_proyek
  karyawan
}

enum PartnerType {
  customer
  supplier
  both
}

enum EmploymentStatus {
  tetap
  harian
  kontrak
}

enum ItemType {
  stock
  service
}

enum ProjectStatus {
  draft
  running
  done
  cancelled
}

enum PoStatus {
  draft
  sent
  received
  cancelled
}

enum PurchaseInvoiceStatus {
  open
  paid
  // §10 data design, item 4 — dibatalkan lewat PATCH /purchase-invoices/:id/void:
  // membuat jurnal pembalik (JournalService.reverseEntry) + stock-out balik dari
  // stock-in yang dibuat faktur ini, bukan menghapus dokumennya.
  void
}

enum SalesOrderStatus {
  draft
  sent
  fulfilled
  cancelled
}

enum DeliveryOrderStatus {
  draft
  sent
  delivered
  cancelled
}

enum SalesInvoiceStatus {
  draft
  sent
  accepted
  paid
  // §10 data design, item 4 — dibatalkan lewat PATCH /sales-invoices/:id/void:
  // membuat jurnal pembalik (JournalService.reverseEntry), bukan menghapus
  // dokumennya. Faktur ini sendiri tidak menggerakkan stok (Surat Jalan yang
  // menggerakkan), jadi void faktur tidak menyentuh stok.
  void
}

enum AttendanceStatus {
  hadir
  izin
  sakit
  alpha
}

// Tiered per docs/DATA_DESIGN.md's "waiting on confirmation" note: pic_proyek
// (atasan langsung) signs off first (tier1_approved), then hrd_keuangan gives
// the final approval that actually disburses cash and posts the journal.
// Either tier can reject, ending the flow.
enum CashAdvanceStatus {
  pending
  tier1_approved
  approved
  rejected
}

enum AccountType {
  aset
  kewajiban
  ekuitas
  pendapatan
  beban
}

enum DepreciationMethod {
  straight_line
}

enum CashTransactionType {
  receipt
  payment
}

// Persediaan §1 (gap module) — metode costing per item. Default average: lebih
// sederhana dan aman sebagai default untuk bisnis yang belum menegaskan butuh FIFO
// (judgment call — lihat laporan akhir tugas ini).
enum CostingMethod {
  average
  fifo
}

// Pabrikasi §2 (gap module) — status Perintah Produksi (Work Order).
enum WorkOrderStatus {
  draft
  in_progress
  done
  cancelled
}

// Kas & Bank §5 (gap module) — Cek/Giro.
enum ChequeGiroType {
  cek
  giro
}

enum ChequeGiroDirection {
  incoming
  outgoing
}

enum ChequeGiroStatus {
  pending
  cleared
  bounced
}

// ---------------------------------------------------------------------------
// Auth / users
// ---------------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(karyawan)
  employeeId   Int?      @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("users")
}

// Sequential document numbering per doc type/year/company (PO-2026-000123 style).
// companyId is a plain scoping key (0 = "no company"), not a FK: Postgres treats
// NULL as distinct in unique indexes, which would break the upsert-based counter
// for every "no company" document, so this deliberately isn't nullable.
model Counter {
  id        Int    @id @default(autoincrement())
  key       String
  year      Int
  companyId Int    @default(0) @map("company_id")
  seq       Int    @default(0)

  @@unique([key, year, companyId])
  @@map("counters")
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Company {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  npwp        String?
  address     String?
  // Ditampilkan di print-out Faktur Penjualan (pengganti area catatan/rekening).
  bankAccount String?   @map("bank_account")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   Int?      @map("created_by")
  deletedAt   DateTime? @map("deleted_at")

  purchaseOrders     PurchaseOrder[]
  salesOrders        SalesOrder[]
  purchaseInvoices   PurchaseInvoice[]
  salesInvoices      SalesInvoice[]
  journalEntries     JournalEntry[]
  cashTransactions   CashTransaction[]
  fixedAssets        FixedAsset[]
  purchaseReturns    PurchaseReturn[]
  salesReturns       SalesReturn[]
  bankStatementLines BankStatementLine[]
  chequeGiros        ChequeGiro[]

  @@map("companies")
}

model Partner {
  id        Int         @id @default(autoincrement())
  code      String      @unique
  name      String
  type      PartnerType
  npwp      String?
  address   String?
  phone     String?
  email     String?
  termDays  Int?        @map("term_days")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  createdBy Int?        @map("created_by")
  deletedAt DateTime?   @map("deleted_at")

  purchaseOrders   PurchaseOrder[]
  salesOrders      SalesOrder[]
  purchaseInvoices PurchaseInvoice[]
  salesInvoices    SalesInvoice[]
  projects         Project[]
  cashTransactions CashTransaction[]
  basts            Bast[]
  chequeGiros      ChequeGiro[]

  @@map("partners")
}

model Employee {
  id               Int              @id @default(autoincrement())
  nik              String           @unique
  name             String
  position         String
  employmentStatus EmploymentStatus @map("employment_status")
  baseSalary       BigInt           @map("base_salary")
  joinDate         DateTime         @map("join_date")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  createdBy        Int?             @map("created_by")
  deletedAt        DateTime?        @map("deleted_at")

  user         User?
  attendances  Attendance[]
  overtimes    Overtime[]
  cashAdvances CashAdvance[]
  loans        EmployeeLoan[]
  payslips     Payslip[]
  tasks        ProjectTask[]
  workReports  WorkReport[]

  @@map("employees")
}

model ItemGroup {
  id        Int         @id @default(autoincrement())
  code      String      @unique
  name      String
  parentId  Int?        @map("parent_id")
  parent    ItemGroup?  @relation("ItemGroupParent", fields: [parentId], references: [id])
  children  ItemGroup[] @relation("ItemGroupParent")
  items     Item[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("item_groups")
}

model Item {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  uom           String
  type          ItemType
  groupId       Int?          @map("group_id")
  group         ItemGroup?    @relation(fields: [groupId], references: [id])
  minStock      Decimal?      @map("min_stock") @db.Decimal(14, 3)
  lastCost      BigInt?       @map("last_cost")
  // Persediaan §1 (gap module) — default average: lihat catatan di enum CostingMethod.
  costingMethod CostingMethod @default(average) @map("costing_method")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdBy     Int?          @map("created_by")
  deletedAt     DateTime?     @map("deleted_at")

  purchaseOrderLines  PurchaseOrderLine[]
  salesOrderLines     SalesOrderLine[]
  deliveryOrderLines  DeliveryOrderLine[]
  salesInvoiceLines   SalesInvoiceLine[]
  bastLines           BastLine[]
  stockMoves          StockMove[]
  stockLayers         StockLayer[]
  purchaseReturnLines PurchaseReturnLine[]
  salesReturnLines    SalesReturnLine[]
  // Pabrikasi §2 (gap module)
  boms                BillOfMaterial[]     @relation("BomProduct")
  bomMaterialLines    BillOfMaterialLine[]
  workOrders          WorkOrder[]

  @@map("items")
}

model Project {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  customerId    Int           @map("customer_id")
  customer      Partner       @relation(fields: [customerId], references: [id])
  contractValue BigInt?       @map("contract_value")
  startDate     DateTime?     @map("start_date")
  targetDate    DateTime?     @map("target_date")
  status        ProjectStatus @default(draft)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdBy     Int?          @map("created_by")
  deletedAt     DateTime?     @map("deleted_at")

  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  deliveryOrders DeliveryOrder[]
  salesInvoices  SalesInvoice[]
  stockMoves     StockMove[]
  tasks          ProjectTask[]
  basts          Bast[]
  workOrders     WorkOrder[]
  budget         ProjectBudget?

  @@map("projects")
}

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

// Persediaan §1 (gap module) — multi-gudang. Setiap stock_move sekarang tertaut
// ke satu gudang; stok per barang per gudang = SUM(qty_in) - SUM(qty_out) yang
// difilter warehouse_id, mengikuti prinsip "stok dari mutasi" yang sudah ada.
model Warehouse {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String
  address   String?
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy Int?      @map("created_by")
  deletedAt DateTime? @map("deleted_at")

  stockMoves  StockMove[]
  stockLayers StockLayer[]
  workOrders  WorkOrder[]

  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// Pembelian
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id         Int       @id @default(autoincrement())
  no         String    @unique
  date       DateTime
  supplierId Int       @map("supplier_id")
  supplier   Partner   @relation(fields: [supplierId], references: [id])
  companyId  Int?      @map("company_id")
  company    Company?  @relation(fields: [companyId], references: [id])
  projectId  Int?      @map("project_id")
  project    Project?  @relation(fields: [projectId], references: [id])
  status     PoStatus  @default(draft)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  createdBy  Int?      @map("created_by")
  deletedAt  DateTime? @map("deleted_at")

  lines            PurchaseOrderLine[]
  purchaseInvoices PurchaseInvoice[]

  @@index([projectId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id        Int           @id @default(autoincrement())
  poId      Int           @map("po_id")
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId    Int           @map("item_id")
  item      Item          @relation(fields: [itemId], references: [id])
  qty       Decimal       @db.Decimal(14, 3)
  unitPrice BigInt        @map("unit_price")
  amount    BigInt

  @@map("purchase_order_lines")
}

// Tidak ada goods_receipt: Emerald tidak menerbitkan GRN sendiri untuk pembelian
// internalnya (beda dengan GRN yang diterbitkan principal/pelanggan seperti Komatsu
// saat menerima kiriman Emerald — itu di luar sistem ini). Faktur Pembelian di sini
// SEKALIGUS jadi bukti penerimaan: begitu dibuat & ditautkan ke PO, PO otomatis
// "received" dan stok item stock-type langsung bertambah dari baris PO tsb.
model PurchaseInvoice {
  id         Int                   @id @default(autoincrement())
  no         String                @unique
  date       DateTime
  supplierId Int                   @map("supplier_id")
  supplier   Partner               @relation(fields: [supplierId], references: [id])
  companyId  Int?                  @map("company_id")
  company    Company?              @relation(fields: [companyId], references: [id])
  poId       Int?                  @map("po_id")
  po         PurchaseOrder?        @relation(fields: [poId], references: [id])
  dpp        BigInt
  ppn        BigInt
  total      BigInt
  status     PurchaseInvoiceStatus @default(open)
  dueDate    DateTime?             @map("due_date")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  createdBy  Int?                  @map("created_by")
  deletedAt  DateTime?             @map("deleted_at")

  cashTransactions CashTransaction[]
  returns          PurchaseReturn[]
  chequeGiros      ChequeGiro[]

  @@map("purchase_invoices")
}

// Retur pembelian: barang yang sudah masuk lewat Faktur Pembelian dikembalikan ke
// pemasok. Jurnalnya kebalikan dari faktur pembelian (kredit Persediaan/HPP + PPN
// Masukan, debit Utang Usaha) dan stoknya keluar lagi (stock_move qtyOut).
model PurchaseReturn {
  id                Int             @id @default(autoincrement())
  no                String          @unique
  date              DateTime
  purchaseInvoiceId Int             @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  companyId         Int?            @map("company_id")
  company           Company?        @relation(fields: [companyId], references: [id])
  reason            String?
  dpp               BigInt
  ppn               BigInt
  total             BigInt
  createdAt         DateTime        @default(now()) @map("created_at")
  createdBy         Int?            @map("created_by")
  deletedAt         DateTime?       @map("deleted_at")

  lines PurchaseReturnLine[]

  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id        Int            @id @default(autoincrement())
  returnId  Int            @map("return_id")
  return    PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId    Int            @map("item_id")
  item      Item           @relation(fields: [itemId], references: [id])
  qty       Decimal        @db.Decimal(14, 3)
  unitPrice BigInt         @map("unit_price")
  amount    BigInt

  @@map("purchase_return_lines")
}

// ---------------------------------------------------------------------------
// Penjualan
// ---------------------------------------------------------------------------

model SalesOrder {
  id         Int              @id @default(autoincrement())
  no         String           @unique
  date       DateTime
  customerId Int              @map("customer_id")
  customer   Partner          @relation(fields: [customerId], references: [id])
  companyId  Int?             @map("company_id")
  company    Company?         @relation(fields: [companyId], references: [id])
  projectId  Int?             @map("project_id")
  project    Project?         @relation(fields: [projectId], references: [id])
  status     SalesOrderStatus @default(draft)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  createdBy  Int?             @map("created_by")
  deletedAt  DateTime?        @map("deleted_at")

  lines          SalesOrderLine[]
  deliveryOrders DeliveryOrder[]

  @@index([projectId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id        Int        @id @default(autoincrement())
  soId      Int        @map("so_id")
  so        SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  itemId    Int        @map("item_id")
  item      Item       @relation(fields: [itemId], references: [id])
  qty       Decimal    @db.Decimal(14, 3)
  unitPrice BigInt     @map("unit_price")
  amount    BigInt

  @@map("sales_order_lines")
}

model DeliveryOrder {
  id        Int                 @id @default(autoincrement())
  no        String              @unique
  date      DateTime
  soId      Int?                @map("so_id")
  so        SalesOrder?         @relation(fields: [soId], references: [id])
  projectId Int?                @map("project_id")
  project   Project?            @relation(fields: [projectId], references: [id])
  status    DeliveryOrderStatus @default(draft)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  createdBy Int?                @map("created_by")
  deletedAt DateTime?           @map("deleted_at")

  lines DeliveryOrderLine[]

  @@index([projectId])
  @@map("delivery_orders")
}

model DeliveryOrderLine {
  id              Int           @id @default(autoincrement())
  deliveryOrderId Int           @map("delivery_order_id")
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  itemId          Int           @map("item_id")
  item            Item          @relation(fields: [itemId], references: [id])
  qty             Decimal       @db.Decimal(14, 3)

  @@map("delivery_order_lines")
}

model SalesInvoice {
  id           Int                @id @default(autoincrement())
  no           String             @unique
  date         DateTime
  customerId   Int                @map("customer_id")
  customer     Partner            @relation(fields: [customerId], references: [id])
  companyId    Int?               @map("company_id")
  company      Company?           @relation(fields: [companyId], references: [id])
  taxInvoiceNo String?            @map("tax_invoice_no")
  poRef        String?            @map("po_ref")
  projectId    Int?               @map("project_id")
  project      Project?           @relation(fields: [projectId], references: [id])
  dpp          BigInt
  ppn          BigInt
  // PPh dipotong oleh pembeli (informational only) — tidak mengurangi `total` atau
  // masuk ke jurnal otomatis; withholding tax itu urusan pencatatan pembeli.
  pph          BigInt             @default(0)
  total        BigInt
  status       SalesInvoiceStatus @default(draft)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  createdBy    Int?               @map("created_by")
  deletedAt    DateTime?          @map("deleted_at")

  lines            SalesInvoiceLine[]
  validations      DocumentValidation[]
  logs             DocumentLog[]
  basts            Bast[]
  cashTransactions CashTransaction[]
  returns          SalesReturn[]
  chequeGiros      ChequeGiro[]

  @@index([projectId])
  @@map("sales_invoices")
}

// Retur penjualan: pelanggan mengembalikan barang yang sudah difaktur. Jurnalnya
// kebalikan dari faktur penjualan (debit Penjualan + PPN Keluaran, kredit Piutang
// Usaha) dan stoknya masuk lagi (stock_move qtyIn).
model SalesReturn {
  id             Int          @id @default(autoincrement())
  no             String       @unique
  date           DateTime
  salesInvoiceId Int          @map("sales_invoice_id")
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id])
  companyId      Int?         @map("company_id")
  company        Company?     @relation(fields: [companyId], references: [id])
  reason         String?
  dpp            BigInt
  ppn            BigInt
  total          BigInt
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      Int?         @map("created_by")
  deletedAt      DateTime?    @map("deleted_at")

  lines SalesReturnLine[]

  @@map("sales_returns")
}

model SalesReturnLine {
  id        Int         @id @default(autoincrement())
  returnId  Int         @map("return_id")
  return    SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId    Int         @map("item_id")
  item      Item        @relation(fields: [itemId], references: [id])
  qty       Decimal     @db.Decimal(14, 3)
  unitPrice BigInt      @map("unit_price")
  amount    BigInt

  @@map("sales_return_lines")
}

model SalesInvoiceLine {
  id             Int          @id @default(autoincrement())
  salesInvoiceId Int          @map("sales_invoice_id")
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  itemId         Int?         @map("item_id")
  item           Item?        @relation(fields: [itemId], references: [id])
  partNo         String?      @map("part_no")
  name           String
  qty            Decimal      @db.Decimal(14, 3)
  uom            String
  unitPrice      BigInt       @map("unit_price")
  amount         BigInt
  // Per baris, bukan cuma di header invoice — satu faktur bisa menagih barang
  // dari beberapa PO pelanggan yang berbeda. Jatuh ke SalesInvoice.poRef kalau kosong.
  poRef          String?      @map("po_ref")

  @@map("sales_invoice_lines")
}

// Meniru "AI validation" ala Komatsu: bandingkan input vendor vs data sistem.
model DocumentValidation {
  id             Int          @id @default(autoincrement())
  salesInvoiceId Int          @map("sales_invoice_id")
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  field          String
  inputValue     String       @map("input_value")
  systemValue    String       @map("system_value")
  isMatch        Boolean      @map("is_match")

  @@map("document_validations")
}

model DocumentLog {
  id             Int          @id @default(autoincrement())
  salesInvoiceId Int          @map("sales_invoice_id")
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  action         String
  status         String
  author         String
  at             DateTime     @default(now())

  @@map("document_logs")
}

// ---------------------------------------------------------------------------
// Persediaan — semua penerimaan/pengiriman/penyesuaian menulis ke stock_moves;
// stok berjalan = SUM(qty_in) - SUM(qty_out), tidak disimpan sebagai angka statis.
// ---------------------------------------------------------------------------

model StockMove {
  id          Int        @id @default(autoincrement())
  itemId      Int        @map("item_id")
  item        Item       @relation(fields: [itemId], references: [id])
  date        DateTime
  refType     String     @map("ref_type")
  refId       Int?       @map("ref_id")
  qtyIn       Decimal    @default(0) @map("qty_in") @db.Decimal(14, 3)
  qtyOut      Decimal    @default(0) @map("qty_out") @db.Decimal(14, 3)
  projectId   Int?       @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id])
  // Persediaan §1 (gap module) — multi-gudang + biaya + batch/serial/kedaluwarsa.
  // warehouseId tetap nullable di skema demi kompatibilitas mundur (mutasi lama
  // sebelum modul ini), tapi service layer sekarang selalu mengisinya (fallback
  // ke gudang default) untuk setiap mutasi baru.
  warehouseId Int?       @map("warehouse_id")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  batchNo     String?    @map("batch_no")
  serialNo    String?    @map("serial_no")
  expiryDate  DateTime?  @map("expiry_date")
  // Biaya per unit pada saat mutasi ini — hasil engine costing (average/FIFO),
  // dipakai baik untuk stock-in (biaya perolehan) maupun stock-out (biaya yang
  // dikonsumsi, dasar HPP). Lihat inventory/costing.service.ts.
  unitCost    BigInt?    @map("unit_cost")
  note        String?
  createdAt   DateTime   @default(now()) @map("created_at")
  createdBy   Int?       @map("created_by")

  @@index([itemId])
  @@index([projectId])
  @@index([warehouseId])
  @@map("stock_moves")
}

// Layer biaya FIFO — hanya dipakai untuk item dengan costingMethod = fifo.
// Setiap stock-in FIFO membuat satu layer baru; stock-out mengonsumsi layer
// tertua dulu (qtyRemaining berkurang), lihat CostingService.consumeFifoLayers.
model StockLayer {
  id           Int       @id @default(autoincrement())
  itemId       Int       @map("item_id")
  item         Item      @relation(fields: [itemId], references: [id])
  warehouseId  Int       @map("warehouse_id")
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  qtyRemaining Decimal   @map("qty_remaining") @db.Decimal(14, 3)
  unitCost     BigInt    @map("unit_cost")
  inDate       DateTime  @map("in_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([itemId, warehouseId])
  @@map("stock_layers")
}

// ---------------------------------------------------------------------------
// Pabrikasi §2 (gap module) — BOM + Work Order, tergantung Persediaan §1 di atas.
// ---------------------------------------------------------------------------

model BillOfMaterial {
  id        Int       @id @default(autoincrement())
  itemId    Int       @map("item_id")
  item      Item      @relation("BomProduct", fields: [itemId], references: [id])
  version   Int       @default(1)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy Int?      @map("created_by")
  deletedAt DateTime? @map("deleted_at")

  lines      BillOfMaterialLine[]
  workOrders WorkOrder[]

  @@unique([itemId, version])
  @@map("bill_of_materials")
}

model BillOfMaterialLine {
  id             Int            @id @default(autoincrement())
  bomId          Int            @map("bom_id")
  bom            BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialItemId Int            @map("material_item_id")
  materialItem   Item           @relation(fields: [materialItemId], references: [id])
  qtyPerUnit     Decimal        @map("qty_per_unit") @db.Decimal(14, 4)
  uom            String

  @@map("bill_of_material_lines")
}

// Posting ke status "done" mengonsumsi bahan (stock-out per baris BOM x planned_qty,
// biaya dari CostingService) dan menghasilkan barang jadi (stock-in pada biaya =
// total bahan terkonsumsi + conversion_cost), lalu memposting satu jurnal produksi —
// lihat ManufacturingService & JournalService.postProduction.
model WorkOrder {
  id             Int             @id @default(autoincrement())
  no             String          @unique
  date           DateTime
  productItemId  Int             @map("product_item_id")
  productItem    Item            @relation(fields: [productItemId], references: [id])
  bomId          Int             @map("bom_id")
  bom            BillOfMaterial  @relation(fields: [bomId], references: [id])
  plannedQty     Decimal         @map("planned_qty") @db.Decimal(14, 3)
  warehouseId    Int             @map("warehouse_id")
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  // Biaya konversi manual (tenaga kerja/overhead) opsional, ditambahkan ke biaya
  // barang jadi saat diposting — lihat §4 aturan jurnal "Produksi Selesai".
  conversionCost BigInt          @default(0) @map("conversion_cost")
  status         WorkOrderStatus @default(draft)
  projectId      Int?            @map("project_id")
  project        Project?        @relation(fields: [projectId], references: [id])
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      Int?            @map("created_by")
  deletedAt      DateTime?       @map("deleted_at")

  @@index([projectId])
  @@map("work_orders")
}

// ---------------------------------------------------------------------------
// Proyek
// ---------------------------------------------------------------------------

model ProjectTask {
  id          Int           @id @default(autoincrement())
  projectId   Int           @map("project_id")
  project     Project       @relation(fields: [projectId], references: [id])
  name        String
  picId       Int?          @map("pic_id")
  pic         Employee?     @relation(fields: [picId], references: [id])
  planStart   DateTime?     @map("plan_start")
  planEnd     DateTime?     @map("plan_end")
  actualStart DateTime?     @map("actual_start")
  actualEnd   DateTime?     @map("actual_end")
  deadline    DateTime?
  progress    Int           @default(0)
  dependsOnId Int?          @map("depends_on_id")
  dependsOn   ProjectTask?  @relation("TaskDepends", fields: [dependsOnId], references: [id])
  dependents  ProjectTask[] @relation("TaskDepends")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workReports WorkReport[]

  @@index([projectId])
  @@map("project_tasks")
}

model WorkReport {
  id          Int         @id @default(autoincrement())
  taskId      Int         @map("task_id")
  task        ProjectTask @relation(fields: [taskId], references: [id])
  employeeId  Int         @map("employee_id")
  employee    Employee    @relation(fields: [employeeId], references: [id])
  date        DateTime
  description String
  progress    Int
  photoUrl    String?     @map("photo_url")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("work_reports")
}

model Bast {
  id              Int           @id @default(autoincrement())
  no              String        @unique
  date            DateTime
  projectId       Int?          @map("project_id")
  project         Project?      @relation(fields: [projectId], references: [id])
  poRef           String?       @map("po_ref")
  customerId      Int           @map("customer_id")
  customer        Partner       @relation(fields: [customerId], references: [id])
  sourceInvoiceId Int?          @map("source_invoice_id")
  sourceInvoice   SalesInvoice? @relation(fields: [sourceInvoiceId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdBy       Int?          @map("created_by")

  lines BastLine[]

  @@map("basts")
}

model BastLine {
  id     Int     @id @default(autoincrement())
  bastId Int     @map("bast_id")
  bast   Bast    @relation(fields: [bastId], references: [id], onDelete: Cascade)
  itemId Int?    @map("item_id")
  item   Item?   @relation(fields: [itemId], references: [id])
  partNo String? @map("part_no")
  name   String
  qty    Decimal @db.Decimal(14, 3)
  uom    String

  @@map("bast_lines")
}

// ---------------------------------------------------------------------------
// Absensi & Gaji
// ---------------------------------------------------------------------------

model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int              @map("employee_id")
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime
  clockIn    DateTime?        @map("clock_in")
  clockOut   DateTime?        @map("clock_out")
  status     AttendanceStatus

  @@unique([employeeId, date])
  @@map("attendance")
}

model Overtime {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  hours      Decimal  @db.Decimal(5, 2)
  rate       BigInt
  amount     BigInt
  approvedBy Int?     @map("approved_by")

  @@map("overtime")
}

// alur: karyawan ajukan (pending) -> HRD approve/reject -> approved menambah `remaining`,
// dicicil lewat payslip.kasbonInstallment.
model CashAdvance {
  id         Int               @id @default(autoincrement())
  employeeId Int               @map("employee_id")
  employee   Employee          @relation(fields: [employeeId], references: [id])
  date       DateTime
  amount     BigInt
  reason     String
  status     CashAdvanceStatus @default(pending)
  // Tier 1 (pic_proyek/atasan) sign-off — required before HRD's final decision.
  tier1By    Int?              @map("tier1_by")
  // Final decision maker: whoever approved (HRD) or rejected (either tier).
  approvedBy Int?              @map("approved_by")
  remaining  BigInt
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@map("cash_advances")
}

model EmployeeLoan {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  principal   BigInt
  remaining   BigInt
  installment BigInt

  @@map("employee_loans")
}

model Payslip {
  id                Int      @id @default(autoincrement())
  employeeId        Int      @map("employee_id")
  employee          Employee @relation(fields: [employeeId], references: [id])
  period            String // format YYYY-MM
  baseSalary        BigInt   @map("base_salary")
  allowance         BigInt   @default(0)
  overtimeAmount    BigInt   @default(0) @map("overtime_amount")
  gross             BigInt
  bpjs              BigInt   @default(0)
  taxPph21          BigInt   @default(0) @map("tax_pph21")
  kasbonInstallment BigInt   @default(0) @map("kasbon_installment")
  loanInstallment   BigInt   @default(0) @map("loan_installment")
  deductionTotal    BigInt   @map("deduction_total")
  netPay            BigInt   @map("net_pay")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         Int?     @map("created_by")

  @@unique([employeeId, period])
  @@map("payslips")
}

// ---------------------------------------------------------------------------
// Akuntansi
// ---------------------------------------------------------------------------

model Account {
  id        Int         @id @default(autoincrement())
  code      String      @unique
  name      String
  type      AccountType
  taxCode   String?     @map("tax_code") // Kode Akun Pajak (KAP) Coretax, PER-10/PJ/2024
  taxName   String?     @map("tax_name")
  // §10 data design, item 5 — dipakai untuk mengelompokkan Neraca jadi Aset
  // Lancar/Tidak Lancar dan Kewajiban Lancar/Jangka Panjang (struktur PSAK 1),
  // bukan cuma daftar rata semua akun aset/kewajiban. Hanya relevan untuk akun
  // bertipe aset/kewajiban; default true (lancar) karena mayoritas akun di COA
  // dasar sistem ini memang lancar — akun yang jelas tidak lancar (Aktiva Tetap,
  // Akumulasi Penyusutan) ditandai false di seed.ts. COA sengaja bisa diedit per
  // perusahaan (§5), jadi ini field data, bukan pola nama/kode akun yang di-hardcode.
  isCurrent Boolean     @default(true) @map("is_current")
  parentId  Int?        @map("parent_id")
  parent    Account?    @relation("AccountParent", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountParent")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  journalLines       JournalLine[]
  cashTransactions   CashTransaction[]
  bankStatementLines BankStatementLine[]
  budgets            Budget[]
  chequeGiros        ChequeGiro[]

  @@map("accounts")
}

// Jurnal SELALU dibuat oleh engine (is_auto = true) dari transaksi lain — lihat
// JournalService. ref_type/ref_id menunjuk balik ke dokumen sumber secara generik,
// jadi menambah jenis transaksi baru tidak perlu mengubah skema ini.
//
// §10 data design, item 4 — pembatalan entry yang sudah posting SELALU lewat
// jurnal pembalik (JournalService.reverseEntry), tidak pernah UPDATE/DELETE baris
// jurnal yang sudah ada (itu prinsip "no man touch" §4 — sekali posting, baris
// jurnal itu sendiri tidak pernah diubah). `voidedAt` ditandai di entry ASAL saat
// entry pembaliknya dibuat; `reversalOfId` ada di entry PEMBALIK, unik supaya satu
// entry asal cuma bisa dibalik sekali.
model JournalEntry {
  id           Int           @id @default(autoincrement())
  no           String        @unique
  date         DateTime
  refType      String        @map("ref_type")
  refId        Int           @map("ref_id")
  refNo        String?       @map("ref_no")
  type         String
  isAuto       Boolean       @default(true) @map("is_auto")
  companyId    Int?          @map("company_id")
  company      Company?      @relation(fields: [companyId], references: [id])
  voidedAt     DateTime?     @map("voided_at")
  reversalOfId Int?          @unique @map("reversal_of_id")
  reversalOf   JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("JournalReversal")
  createdAt    DateTime      @default(now()) @map("created_at")
  createdBy    Int?          @map("created_by")

  lines JournalLine[]

  @@index([refType, refId])
  @@map("journal_entries")
}

model JournalLine {
  id        Int          @id @default(autoincrement())
  entryId   Int          @map("entry_id")
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId Int          @map("account_id")
  account   Account      @relation(fields: [accountId], references: [id])
  debit     BigInt       @default(0)
  credit    BigInt       @default(0)

  @@map("journal_lines")
}

model FixedAsset {
  id                      Int                @id @default(autoincrement())
  code                    String             @unique
  name                    String
  acquisitionDate         DateTime           @map("acquisition_date")
  cost                    BigInt
  usefulLifeMonths        Int                @map("useful_life_months")
  method                  DepreciationMethod @default(straight_line)
  accumulatedDepreciation BigInt             @default(0) @map("accumulated_depreciation")
  bookValue               BigInt             @map("book_value")
  lastDepreciatedPeriod   String?            @map("last_depreciated_period") // YYYY-MM, guards against double-running a period
  companyId               Int?               @map("company_id")
  company                 Company?           @relation(fields: [companyId], references: [id])
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  @@map("fixed_assets")
}

// Kas & Bank — minimal: penerimaan dari pelanggan / pembayaran ke pemasok,
// cukup untuk memicu aturan jurnal §4. Buku bank & rekonsiliasi menyusul.
model CashTransaction {
  id                Int                 @id @default(autoincrement())
  no                String              @unique
  type              CashTransactionType
  date              DateTime
  partnerId         Int?                @map("partner_id")
  partner           Partner?            @relation(fields: [partnerId], references: [id])
  accountId         Int                 @map("account_id") // akun Kas/Bank yang dipakai
  account           Account             @relation(fields: [accountId], references: [id])
  amount            BigInt
  salesInvoiceId    Int?                @map("sales_invoice_id")
  salesInvoice      SalesInvoice?       @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoiceId Int?                @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice?    @relation(fields: [purchaseInvoiceId], references: [id])
  companyId         Int?                @map("company_id")
  company           Company?            @relation(fields: [companyId], references: [id])
  note              String?
  createdAt         DateTime            @default(now()) @map("created_at")
  createdBy         Int?                @map("created_by")

  bankStatementLine BankStatementLine?
  chequeGiro        ChequeGiro?

  @@map("cash_transactions")
}

// Rekonsiliasi bank: baris mutasi rekening koran, dientri manual (bank lokal
// belum ada API feed). Tidak menyentuh jurnal — CashTransaction sudah posting
// saat dibuat, ini murni alat pencocokan "yang sistem catat" vs "yang bank
// catat". amount positif = uang masuk, negatif = uang keluar, mengikuti tanda
// di rekening koran aslinya.
model BankStatementLine {
  id                Int              @id @default(autoincrement())
  accountId         Int              @map("account_id")
  account           Account          @relation(fields: [accountId], references: [id])
  date              DateTime
  description       String
  amount            BigInt
  companyId         Int?             @map("company_id")
  company           Company?         @relation(fields: [companyId], references: [id])
  cashTransactionId Int?             @unique @map("cash_transaction_id")
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id])
  createdAt         DateTime         @default(now()) @map("created_at")
  createdBy         Int?             @map("created_by")

  @@index([accountId])
  @@map("bank_statement_lines")
}

// Buku Besar §3 (gap module) — Anggaran per akun + Monitor Anggaran. Satu baris per
// kombinasi perusahaan+periode+akun; "Monitor Anggaran" (lihat BudgetsService.monitor)
// membandingkannya terhadap realisasi (SUM journal_line pada periode yang sama) —
// bukan jenis transaksi baru, murni fitur baca/perbandingan.
model Budget {
  id        Int      @id @default(autoincrement())
  // 0 = seluruh perusahaan (tanpa company spesifik) — bukan FK nullable, mengikuti pola
  // Counter.companyId: NULL tidak unik di Postgres, upsert butuh kolom non-null.
  companyId Int      @default(0) @map("company_id")
  period    String // format YYYY-MM
  accountId Int      @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id])
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int?     @map("created_by")

  @@unique([companyId, period, accountId])
  @@map("budgets")
}

// Proyek §4 (gap module) — RAB (Rencana Anggaran Biaya) per proyek. Satu RAB per
// proyek (project_id unik); realisasi dibandingkan lewat ProjectBudgetsService,
// dihitung dari transaksi yang sudah di-tag project_id (purchase_invoice via PO,
// stock_move keluar) — bukan input baru, mengikuti prinsip "no man touch"/tidak
// ada input ganda yang sudah dipakai modul Proyek (§2 dokumen ini).
model ProjectBudget {
  id        Int      @id @default(autoincrement())
  projectId Int      @unique @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy Int?     @map("created_by")

  lines ProjectBudgetLine[]

  @@map("project_budgets")
}

model ProjectBudgetLine {
  id              Int           @id @default(autoincrement())
  projectBudgetId Int           @map("project_budget_id")
  projectBudget   ProjectBudget @relation(fields: [projectBudgetId], references: [id], onDelete: Cascade)
  category        String?
  description     String
  plannedAmount   BigInt        @map("planned_amount")

  @@map("project_budget_lines")
}

// Kas & Bank §5 (gap module) — Cek/Giro. Selalu tertaut ke faktur yang dilunasinya
// (incoming -> sales_invoice, outgoing -> purchase_invoice) supaya "cleared" bisa
// memakai CashTransactionsService yang SUDAH ADA (postCustomerReceipt/
// postSupplierPayment, §4) alih-alih menulis aturan jurnal baru — cek/giro murni
// instrumen pembayaran yang pencairannya tertunda, bukan jenis transaksi akuntansi
// baru. bounced tidak menyentuh jurnal sama sekali (uang memang tidak pernah pindah).
model ChequeGiro {
  id          Int                 @id @default(autoincrement())
  no          String              @unique
  type        ChequeGiroType
  bankAccount String              @map("bank_account")
  amount      BigInt
  dueDate     DateTime            @map("due_date")
  direction   ChequeGiroDirection
  status      ChequeGiroStatus    @default(pending)
  // Akun Kas/Bank GL yang dipakai saat dicairkan (bukan bank_account di atas, yang
  // cuma teks deskriptif nama bank/no rekening cek fisiknya).
  accountId   Int                 @map("account_id")
  account     Account             @relation(fields: [accountId], references: [id])
  partnerId   Int?                @map("partner_id")
  partner     Partner?            @relation(fields: [partnerId], references: [id])

  salesInvoiceId    Int?             @map("sales_invoice_id")
  salesInvoice      SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoiceId Int?             @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  companyId         Int?             @map("company_id")
  company           Company?         @relation(fields: [companyId], references: [id])
  cashTransactionId Int?             @unique @map("cash_transaction_id")
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id])

  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy Int?      @map("created_by")
  deletedAt DateTime? @map("deleted_at")

  @@map("cheque_giros")
}

// §10 data design, item 6 — tutup buku periode. Belum ada mekanisme ini sebelumnya
// (lihat komentar lama di ReportsService.neraca) padahal §2/§8 dokumen ini sudah
// menyebut "tutup buku" sebagai bagian modul Buku Besar sejak awal. Menutup sebuah
// periode mencegah JournalService.postEntry() memposting entry baru bertanggal di
// periode itu (lihat pengecekannya di sana) — jadi enforcement-nya ada di SATU
// titik yang sudah jadi gerbang semua posting otomatis, bukan tersebar di tiap
// modul transaksi.
model ClosedPeriod {
  id        Int      @id @default(autoincrement())
  // 0 = seluruh perusahaan — pola sama dengan Budget.companyId/Counter.companyId
  // (NULL tidak unik di Postgres, unique constraint butuh kolom non-null).
  companyId Int      @default(0) @map("company_id")
  period    String // format YYYY-MM
  closedAt  DateTime @default(now()) @map("closed_at")
  closedBy  Int?     @map("closed_by")

  @@unique([companyId, period])
  @@map("closed_periods")
}

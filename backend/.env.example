# PostgreSQL connection used by Prisma + the app
DATABASE_URL="postgresql://emerald:emerald@localhost:5432/emerald?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (your frontend URL/domain)
CORS_ORIGIN="http://localhost:5173"

# Seed: initial admin login created by `npm run prisma:seed`
SEED_ADMIN_EMAIL="admin@emeralddutasejahtera.co.id"
SEED_ADMIN_PASSWORD="ChangeMe123!"
